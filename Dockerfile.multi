FROM alpine:latest

# tzdata 必须装: 容器默认时区是 UTC, 缺了它 time.LoadLocation("Asia/Singapore") 会失败
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /root/

# 只构建 amd64: build.yml 的 platforms 已收敛为 linux/amd64。
# 若将来恢复 arm64 构建, 这里要改回按 TARGETARCH 分支拷贝对应产物。
COPY main-amd64 ./main
RUN chmod +x main

CMD ["./main"]
